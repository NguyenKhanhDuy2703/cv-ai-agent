  "cards": [
    {
      "dot": "cyan",
      "title": "Stateless Request & SSE Envelopes",
      "items": [
        "Backend sends GenerateCvRequest with client-stable requestId; bearer token verified against AI_SECRET_KEY",
        "GenerateService maintains an asyncio.Queue, wrapping events with sequence numbers and returning text/event-stream"
      ]
    },
    {
      "dot": "rose",
      "title": "Deterministic Safety & Partial Updates",
      "items": [
        "Each generated section passes DeterministicGuard; ungrounded statements fallback to original facts",
        "Successful sections immediately emit partial_update events so backend subscribers view live progress"
      ]
    },
    {
      "dot": "emerald",
      "title": "RenderCV Schema Validation & Terminal Event",
      "items": [
        "Before finishing, canonical document is validated against render_cv_schema.json and serialized to YAML",
        "Exactly one terminal event (needs_input, done, or error) closes the SSE stream with full report"
      ]
    }
  ]
