  "cards": [
    {
      "dot": "cyan",
      "title": "Durable Ingestion & Replayable Streaming",
      "items": [
        "POST /v1/ai/generations accepts requests, deduplicates by requestId, persists snapshot, and returns 202 Accepted",
        "GET /v1/ai/generations/{id}/events streams persisted events using Last-Event-ID cursors; client disconnects never cancel generation"
      ]
    },
    {
      "dot": "rose",
      "title": "Worker Isolation & Safe Error Handling",
      "items": [
        "GenerationWorker runs in a dedicated process, claiming jobs via SELECT ... FOR UPDATE SKIP LOCKED",
        "Lease tokens and background heartbeats prevent race conditions; JOB_CONTEXT tracks jobId/requestId/attempt",
        "Khi phát sinh lỗi, safe_error_details phân loại mã lỗi (LLM_RATE_LIMIT, LLM_TIMEOUT, LLM_SCHEMA_ERROR) và lưu vết an toàn"
      ]
    },
    {
      "dot": "emerald",
      "title": "Canonical Validation & Result Persistence",
      "items": [
        "Pipeline ensures 0% metric fabrication and validates the assembled document against RenderCV canonical JSON schema",
        "Final status (COMPLETED), serialized cvYaml, and terminal done event commit together atomically in PostgreSQL"
      ]
    }
  ]
