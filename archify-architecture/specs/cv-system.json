  "cards": [
    {
      "dot": "cyan",
      "title": "Durable State & Process Decoupling",
      "items": [
        "AI service owns durable generation state in PostgreSQL: jobs, immutable input snapshots, attempts, leases, and replayable event logs",
        "FastAPI gateway accepts requests (POST 202) and serves replayable SSE (Last-Event-ID) without holding pipeline execution",
        "Independent background worker claims jobs with SKIP LOCKED, maintains heartbeat leases, and tracks context via JOB_CONTEXT"
      ]
    },
    {
      "dot": "rose",
      "title": "Candidate Evidence Isolation & 0% Fabrication",
      "items": [
        "build_candidate_evidence bóc tách Ground-Truth Evidence (con số, tỷ lệ, công nghệ) kèm ID cố định",
        "DeterministicGuard ép buộc 0% dung sai bịa đặt số liệu và loại bỏ hoàn toàn buzzwords sáo rỗng",
        "Tất cả prompt & schema calls đều qua generate_at_stage; lỗi được phân loại an toàn không làm lộ dữ liệu cá nhân"
      ]
    },
    {
      "dot": "emerald",
      "title": "Live Gemini Provider & RenderCV Compliance",
      "items": [
        "Chỉ hỗ trợ Gemini live provider (gemini-2.0-flash / 2.5); mock offline provider đã được gỡ bỏ hoàn toàn",
        "assert_canonical_document validates full JSON structure against the RenderCV canonical schema before YAML serialization",
        "Terminal state (COMPLETED / NEEDS_INPUT / FAILED), validated result, and safe diagnostic codes commit in one transaction"
      ]
    }
  ]
