  "cards": [
    {
      "dot": "cyan",
      "title": "API Gateway & SSE Streaming",
      "items": [
        "FastAPI gateway enforces 10MB payload limit (AI_MAX_BODY_SIZE) and privacy-safe access logging",
        "verify_service_bearer validates service-to-service Bearer tokens against AI_SECRET_KEY",
        "GenerateService streams progress, gap reports, partial section updates, and terminal done/needs_input"
      ]
    },
    {
      "dot": "rose",
      "title": "Candidate Evidence Isolation & 0% Fabrication",
      "items": [
        "build_candidate_evidence bóc tách Ground-Truth Evidence (con số, tỷ lệ, công nghệ) kèm ID cố định",
        "DeterministicGuard ép buộc 0% dung sai bịa đặt số liệu và loại bỏ hoàn toàn buzzwords sáo rỗng",
        "Ungrounded proposals fall back to original candidate facts, guaranteeing valid truthful output"
      ]
    },
    {
      "dot": "emerald",
      "title": "RenderCV Canonical Schema Compliance",
      "items": [
        "build_canonical_document merges candidate content with Render template design, locale, and settings",
        "assert_canonical_document validates full JSON structure against the RenderCV canonical schema",
        "Output is serialized to YAML (cvYaml) and returned alongside structured document in the done event"
      ]
    }
  ]
