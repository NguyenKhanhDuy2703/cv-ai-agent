  "cards": [
    {
      "dot": "cyan",
      "title": "Intake, Gap Detection & Evidence Isolation",
      "items": [
        "Normalize request and execute detect_gaps(); missing required items returns terminal needs_input immediately without invoking LLM",
        "Candidate Profile is the sole source of candidate facts, preserved in an immutable EvidenceStore with stable client IDs"
      ]
    },
    {
      "dot": "rose",
      "title": "JD Analysis, Static RAG & Typed Writers",
      "items": [
        "JDAnalyzer extracts seniority, role family, required/preferred skills and keywords with deterministic fallback",
        "StaticKnowledgeRetriever performs BM25 retrieval across vetted industry packs for summary, experience, and project phrasing",
        "Typed section writers (SummaryWriter, ExperienceWriter, ProjectWriter) produce structured proposals citing evidence IDs"
      ]
    },
    {
      "dot": "emerald",
      "title": "Deterministic 0% Guard & Canonical Compliance",
      "items": [
        "DeterministicGuard verifies numbers, dates, technologies, and metrics against cited evidence IDs with zero tolerance",
        "Ungrounded claims automatically fall back to original candidate facts, guaranteeing a valid partial result",
        "Canonical document complies strictly with RenderCV schema and is serialized to YAML before SSE completion"
      ]
    }
  ]
