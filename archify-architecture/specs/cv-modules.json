      ]
    },
    {
      "dot": "emerald",
      "title": "Data Contract & Guard Enforcements",
      "items": [
        "src/schemas & src/jobs định nghĩa DTO chuẩn GenerateCvRequest, JobView và tương thích RenderCV canonical schema",
        "src/guard hoạt động độc lập và thực thi kiểm định tất định 0% sai số số liệu đối chiếu EvidenceStore"
      ]
    }
