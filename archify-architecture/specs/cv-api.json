  "cards": [
    {
      "dot": "cyan",
      "title": "Server Bootstrap & Lifespan Health",
      "items": [
        "src/main.py starts Uvicorn ASGI server binding to AI_PORT (default 8001)",
        "FastAPI lifespan initializes Database and JobRepository connection pool at startup",
        "/health/ready probes database connectivity and Alembic migration revision before routing traffic"
      ]
    },
    {
      "dot": "rose",
      "title": "Service Bearer Security & Job Routing",
      "items": [
        "src/api/auth.py exposes verify_service_bearer FastAPI dependency checking Authorization Bearer token against AI_SECRET_KEY",
        "POST /v1/ai/generations accepts CreateGenerationRequest, deduplicates by requestId, persists snapshot, and returns 202 with status URL",
        "GET /v1/ai/generations/{id}/events streams persisted SSE events with Last-Event-ID reconnection support"
      ]
    },
    {
      "dot": "emerald",
      "title": "Job Store & Independent Worker Execution",
      "items": [
        "src/jobs/repository.py manages durable jobs, event logs, and atomic state transitions in PostgreSQL",
        "src/worker.py polls for QUEUED jobs using SELECT ... FOR UPDATE SKIP LOCKED and acquires fenced leases",
        "Client disconnects never abort worker execution; results and events remain durable for 24-hour retention"
      ]
    }
  ]
