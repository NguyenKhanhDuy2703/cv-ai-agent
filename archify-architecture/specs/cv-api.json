  "cards": [
    {
      "dot": "cyan",
      "title": "Server Bootstrap & Middlewares",
      "items": [
        "src/main.py starts Uvicorn ASGI server binding to AI_PORT (default 8001)",
        "src/config.py loads and validates environment variables with Pydantic BaseSettings",
        "src/api/server.py registers CORSMiddleware, health probes, and 10MB body limit"
      ]
    },
    {
      "dot": "rose",
      "title": "Service Bearer Security & API Routers",
      "items": [
        "src/api/auth.py exposes verify_service_bearer FastAPI dependency checking Authorization Bearer token against AI_SECRET_KEY",
        "src/api/routes.py handles backend-only POST /v1/ai/generate/stream with StreamingResponse",
        "Validates GenerateCvRequest payload containing job description, candidate profile, and Render template settings"
      ]
    },
    {
      "dot": "emerald",
      "title": "Generate Service & Core Orchestrator",
      "items": [
        "src/api/service.py (GenerateService) manages background asyncio tasks, event buffering, and client disconnect cancellation",
        "Guarantees standard SSE envelopes ({type, requestId, generationId, sequence, data}) across progress, gap_report, and partial_update",
        "Dispatches work to CvGenerationPipeline and emits exactly one terminal event: needs_input, done, or error"
      ]
    }
  ]
