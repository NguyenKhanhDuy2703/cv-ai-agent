  "cards": [
    {
      "dot": "cyan",
      "title": "Server Bootstrap & Middlewares",
      "items": [
        "src/main.py starts Uvicorn ASGI server binding to AI_PORT (default 8001)",
        "src/config.py loads and validates environment variables with Pydantic BaseSettings",
        "src/api/server.py registers CORSMiddleware and an HTTP middleware enforcing 10MB body limit and timing access logs"
      ]
    },
    {
      "dot": "rose",
      "title": "Service Bearer Security & API Routers",
      "items": [
        "src/api/auth.py exposes verify_service_bearer FastAPI dependency checking Authorization Bearer token against AI_SECRET_KEY",
        "src/api/routes.py handles POST /v1/ai/tailor for synchronous diff reports and POST /v1/ai/tailor/stream for real-time SSE streaming",
        "Validates CanonicalTailorRequest (Render contract) and provides backward compatibility for legacy CvInput envelopes"
      ]
    },
    {
      "dot": "emerald",
      "title": "Tailor Service & Core Orchestrator",
      "items": [
        "src/api/service.py (TailorService) manages background asyncio tasks, event buffering, and client disconnect cancellation",
        "Guarantees standard SSE envelopes ({type, runId, sequence, data}) with exactly one terminal 'completed' or 'failed' event",
        "Dispatches work to AgentTailorPipeline across candidate evidence extraction, deterministic guards, and Gemini LLM provider"
      ]
    }
  ]
