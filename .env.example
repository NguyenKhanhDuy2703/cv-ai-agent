# AI Provider Configuration
# Runtime provider: gemini. Test doubles are only available in tests/.
AI_PROVIDER=gemini

# Required for the worker: use a model ID enabled for your Gemini account.
AI_MODEL=your_model_id

# Gemini API key (required by the generation worker)
AI_API_KEY=your_gemini_api_key_here

# Service-to-service Bearer authentication key (optional in local dev, recommended in prod)
AI_SECRET_KEY=

# Server Port
AI_PORT=8001

# Maximum HTTP request body size in bytes (default: 10 MiB)
AI_MAX_BODY_SIZE=10485760

# AI-owned PostgreSQL, never the Render database. Migrate before starting API/worker.
AI_DATABASE_URL=postgresql+psycopg://cv_ai:cv_ai_local@localhost:55432/cv_ai
AI_WORKER_POLL_SECONDS=1
AI_WORKER_CONCURRENCY=2
AI_JOB_TIMEOUT_SECONDS=120
AI_JOB_MAX_ATTEMPTS=2
AI_LEASE_SECONDS=30
AI_HEARTBEAT_SECONDS=5
AI_RETENTION_HOURS=24
AI_SSE_POLL_SECONDS=0.5
AI_SSE_HEARTBEAT_SECONDS=15

